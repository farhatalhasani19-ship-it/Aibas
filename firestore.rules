rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDiaryMember(data) {
      return isAuthenticated() && ('memberUids' in data) && (request.auth.uid in data.memberUids);
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Diaries
    match /diaries/{diaryId} {
      // Allow read if user is member OR if diary is awaiting partner join
      allow read: if isAuthenticated() && (
        (request.auth.uid in resource.data.memberUids) ||
        !('partnerUid' in resource.data) ||
        resource.data.partnerUid == null ||
        resource.data.partnerUid == ''
      );

      // Create new diary
      allow create: if isAuthenticated() &&
        request.resource.data.ownerUid == request.auth.uid &&
        (request.auth.uid in request.resource.data.memberUids);

      // Update diary (e.g. partner joining or updating names/anniversary)
      allow update: if isAuthenticated() && (
        (request.auth.uid in resource.data.memberUids) ||
        (
          (!('partnerUid' in resource.data) || resource.data.partnerUid == null || resource.data.partnerUid == '') &&
          request.resource.data.partnerUid == request.auth.uid &&
          (request.auth.uid in request.resource.data.memberUids)
        )
      );

      // Delete only by owner
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;

      // Subcollection: Entries
      match /entries/{entryId} {
        allow read: if isDiaryMember(resource.data);
        allow create: if isAuthenticated() &&
          (request.auth.uid in request.resource.data.memberUids) &&
          request.resource.data.authorUid == request.auth.uid;
        allow update: if isDiaryMember(resource.data) && (request.auth.uid in request.resource.data.memberUids);
        allow delete: if isDiaryMember(resource.data);
      }

      // Subcollection: Memories
      match /memories/{memoryId} {
        allow read: if isDiaryMember(resource.data);
        allow create: if isAuthenticated() &&
          (request.auth.uid in request.resource.data.memberUids) &&
          request.resource.data.authorUid == request.auth.uid;
        allow update: if isDiaryMember(resource.data) && (request.auth.uid in request.resource.data.memberUids);
        allow delete: if isDiaryMember(resource.data);
      }

      // Subcollection: Love Letters (Drafts are strictly private to the author)
      match /letters/{letterId} {
        allow read: if isDiaryMember(resource.data) &&
          (!resource.data.isDraft || resource.data.authorUid == request.auth.uid);
        allow create: if isAuthenticated() &&
          (request.auth.uid in request.resource.data.memberUids) &&
          request.resource.data.authorUid == request.auth.uid;
        allow update: if isDiaryMember(resource.data) &&
          (request.auth.uid in request.resource.data.memberUids) &&
          (!resource.data.isDraft || resource.data.authorUid == request.auth.uid);
        allow delete: if isDiaryMember(resource.data) &&
          (!resource.data.isDraft || resource.data.authorUid == request.auth.uid);
      }

      // Subcollection: Timeline
      match /timeline/{eventId} {
        allow read: if isDiaryMember(resource.data);
        allow create: if isAuthenticated() &&
          (request.auth.uid in request.resource.data.memberUids) &&
          request.resource.data.authorUid == request.auth.uid;
        allow update: if isDiaryMember(resource.data) && (request.auth.uid in request.resource.data.memberUids);
        allow delete: if isDiaryMember(resource.data);
      }

      // Subcollection: Little Things
      match /littleThings/{itemId} {
        allow read: if isDiaryMember(resource.data);
        allow create: if isAuthenticated() &&
          (request.auth.uid in request.resource.data.memberUids) &&
          request.resource.data.authorUid == request.auth.uid;
        allow update: if isDiaryMember(resource.data) && (request.auth.uid in request.resource.data.memberUids);
        allow delete: if isDiaryMember(resource.data);
      }

      // Subcollection: Surprise
      match /surprise/{surpriseId} {
        allow read: if isDiaryMember(resource.data);
        allow create, update: if isAuthenticated() && (request.auth.uid in request.resource.data.memberUids);
        allow delete: if isDiaryMember(resource.data);
      }

      // Subcollection: Backups
      match /backups/{backupId} {
        allow read: if isDiaryMember(resource.data);
        allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.memberUids);
        allow delete: if isDiaryMember(resource.data);
      }
    }
  }
}
